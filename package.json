{
  "name": "useless-polymath",
  "private": true,
  "version": "0.0.5",
  "description": "A React suite of 24 interactive tools for practicing mental math, base conversions, ciphers, and technical systems.",
  "author": "Carlos Bolivar <carlos@carlosblog.com>",
  "license": "MIT",
  "homepage": "https://useless-polymath.carlosblog.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kbtale/Useless-Polymath"
  },
  "keywords": [
    "react",
    "typescript",
    "mental-math",
    "binary",
    "hexadecimal",
    "subnetting",
    "morse-code",
    "doomsday-algorithm",
    "practice",
    "education"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "i18next-http-backend": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.103.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
