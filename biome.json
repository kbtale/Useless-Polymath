{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noInnerDeclarations": "error"
      },
      "a11y": {
        "useKeyWithClickEvents": "error",
        "useFocusableInteractive": "error",
        "useValidAriaValues": "error",
        "useButtonType": "error",
        "useAltText": "error",
        "noAriaHiddenOnFocusable": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useSelfClosingElements": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noVar": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/modules/cryptography/braille/BraillePractice.tsx",
        "src/modules/cryptography/braille/BrailleTool.tsx",
        "src/modules/cryptography/morse_code/MorseTool.tsx",
        "src/modules/cryptography/nato_alphabet/NatoPractice.tsx",
        "src/modules/cryptography/nato_alphabet/NatoTool.tsx",
        "src/modules/logic/ean_13/EanTool.tsx",
        "src/modules/logic/luhn_algorithm/LuhnPractice.tsx",
        "src/modules/logic/luhn_algorithm/LuhnTool.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
